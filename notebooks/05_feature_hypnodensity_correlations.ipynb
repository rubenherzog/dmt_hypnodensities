    "## iv) Plotting helpers\n",
    "\n",
    "`stage_feature_effect_correlations` is generic enough to correlate any two sets of columns\n",
    "within an arbitrary grouping â€” it is reused here for raw values instead of treatment\n",
    "effects by passing the probability and feature columns directly, with the grouping columns\n",
    "that define each analysis below (`stager` alone for the global analysis, plus `electrode`\n",
    "and/or `experimental_label`/`condition` for the more granular ones).\n",
    "\n",
    "Two small local helpers turn one such correlation table into a stage Ã— feature matrix, and\n",
    "lay out several matrices side by side for comparison. They are kept in the notebook because\n",
    "each analysis below needs a different combination of panels."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "1c57f1e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def pivot_correlation_matrix(table, row='stage', col='feature', value='correlation'):\n",
    "    \"\"\"Reshape one long correlation table into a stage x feature matrix.\"\"\"\n",
    "\n",
    "    matrix = table.pivot(index=row, columns=col, values=value)\n",
    "    order = [stage for stage in STAGES if stage in matrix.index]\n",
    "    return matrix.reindex(order)\n",
    "\n",
    "\n",
    "def plot_correlation_grid(\n",
    "    panels, ncols=3, value_label='Correlation r', vmin=-1, vmax=1,\n",
    "    cmap='coolwarm', figsize=None\n",
    "):\n",
    "    \"\"\"Plot a dict of {panel title: stage x feature matrix} as a shared-scale grid.\"\"\"\n",
    "\n",
    "    n_panels = len(panels)\n",
    "    ncols = min(ncols, n_panels)\n",
    "    nrows = int(np.ceil(n_panels / ncols))\n",
    "    figure, axes = plt.subplots(\n",
    "        nrows, ncols, figsize=figsize or (4 * ncols, 10 * nrows), squeeze=False,\n",
    "        constrained_layout=True,\n",
    "    )\n",
    "    image = None\n",
    "    for index, (axis, (title, matrix)) in enumerate(zip(axes.flat, panels.items())):\n",
    "        matrix = matrix.T\n",
    "        image = axis.imshow(matrix.to_numpy(), vmin=vmin, vmax=vmax, cmap=cmap, aspect='auto')\n",
    "        axis.set_xticks(np.arange(matrix.shape[1]), matrix.columns, fontsize=9)\n",
    "        if index % ncols == 0:\n",
    "            axis.set_yticks(np.arange(matrix.shape[0]), matrix.index, fontsize=7)\n",
    "        else:\n",
    "            axis.set_yticks([])\n",
    "        axis.set_title(title)\n",
    "    for axis in axes.flat[n_panels:]:\n",
    "        axis.axis('off')\n",
    "    if image is not None:\n",
    "        figure.colorbar(image, ax=axes, label=value_label, shrink=0.8)\n",
    "\n",
    "    return figure, axes\n"
   ]
  },
