    "    correlation_image = axis.imshow(matrix.to_numpy(), vmin=-1, vmax=1, cmap='coolwarm', aspect='auto')\n",
    "    axis.set_xticks(np.arange(matrix.shape[1]), matrix.columns, fontsize=9)\n",
    "    if index == 0:\n",
    "        axis.set_yticks(np.arange(matrix.shape[0]), matrix.index, fontsize=9)\n",
    "    else:\n",
    "        axis.set_yticks([])\n",
    "    axis.set_title(title)\n",
    "\n",
    "std_image = axes[2].imshow(std_matrix.to_numpy(), vmin=0, vmax=None, cmap='viridis', aspect='auto')\n",
    "axes[2].set_xticks(np.arange(std_matrix.shape[1]), std_matrix.columns, fontsize=9)\n",
    "axes[2].set_yticks([])\n",
    "axes[2].set_title('SD across electrodes')\n",
    "\n",
    "\n",
    "figure.colorbar(correlation_image, ax=list(axes[:2]), label='Correlation r', shrink=0.8)\n",
